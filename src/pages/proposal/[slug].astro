---
import { getCollection } from 'astro:content';
import Main from '@/layouts/Main.astro';

export async function getStaticPaths() {
  const proposals = await getCollection('proposals');
  return proposals.map((proposal) => ({
    params: { slug: proposal.slug },
    props: { proposal },
  }));
}

const { proposal } = Astro.props;
const data = proposal.data;
const validDate = new Date(data.validUntil).toLocaleDateString('id-ID', { year: 'numeric', month: 'long', day: 'numeric' });
const createdDate = new Date(data.date).toLocaleDateString('id-ID', { year: 'numeric', month: 'long', day: 'numeric' });
---

<Main title={`${data.title} | Proposal`} description={data.heroDescription}>
  <article class="proposal">

    <!-- ========== HERO ========== -->
    <header class="hero">
      <div class="container">
        <div class="hero-content">
          <div class="hero-badges">
            <span class="badge badge-client">{data.client}</span>
            <span class="badge badge-date">📅 {createdDate}</span>
            <span class="badge badge-valid">⏰ Berlaku hingga {validDate}</span>
          </div>
          <h1>{data.title}</h1>
          <p class="hero-tagline">{data.tagline}</p>
          <p class="hero-desc">{data.heroDescription}</p>
          <div class="hero-actions">
            <a href="#pricing" class="btn btn-white">Lihat Harga →</a>
            <button id="share-btn" class="btn btn-outline-white">🔗 Share</button>
          </div>
        </div>
      </div>
    </header>

    <!-- ========== TOC + CONTENT ========== -->
    <div class="proposal-layout container">
      <!-- Sidebar TOC -->
      <aside class="toc" id="toc">
        <div class="toc-header">
          <span class="toc-title">Daftar Isi</span>
          <button class="toc-toggle" id="toc-toggle" aria-label="Toggle menu">☰</button>
        </div>
        <nav class="toc-nav" id="toc-nav">
          <a href="#pricing" class="toc-link">💰 Harga</a>
          <a href="#phases" class="toc-link">⚙️ Pengerjaan</a>
          <a href="#metrics" class="toc-link">📊 Target Hasil</a>
          {data.addons.length > 0 && <a href="#addons" class="toc-link">✨ Tambahan</a>}
          <a href="#recommendation" class="toc-link">🎯 Rekomendasi</a>
          <a href="#next-steps" class="toc-link">📅 Langkah Selanjutnya</a>
          <a href="#contact" class="toc-link">📞 Kontak</a>
        </nav>
      </aside>

      <!-- Main Content -->
      <div class="proposal-content">

        <!-- ========== PRICING ========== -->
        <section id="pricing" class="section">
          <div class="section-header">
            <span class="section-icon">💰</span>
            <div>
              <h2>Struktur Harga</h2>
              <p class="section-subtitle">Pilih model yang paling cocok untuk bisnis Anda</p>
            </div>
          </div>

          <div class="pricing-grid">
            {/* Performance-Based */}
            {data.pricingModel !== 'fixed' && data.performance && (
              <div class={`pricing-card ${data.recommendedModel === 'performance' ? 'recommended' : ''}`}>
                {data.recommendedModel === 'performance' && (
                  <div class="recommended-badge">⭐ Direkomendasikan</div>
                )}
                <div class="pricing-card-header">
                  <h3>Performance-Based</h3>
                  <p class="pricing-subtitle">Bayar sesuai hasil yang dihasilkan</p>
                </div>
                <div class="pricing-amount">
                  <span class="amount">{data.performance.setupFee}</span>
                  <span class="period">setup fee</span>
                </div>
                <div class="pricing-amount">
                  <span class="amount">{data.performance.monthlyFee}</span>
                  <span class="period">per bulan</span>
                </div>
                <div class="pricing-highlight">
                  <span class="highlight-label">Performance Fee</span>
                  <span class="highlight-value">{data.performance.performanceFee}</span>
                </div>

                {data.performance.feeTiers.length > 0 && (
                  <div class="fee-tiers">
                    <h4>Tingkat Fee</h4>
                    {data.performance.feeTiers.map((tier: any) => (
                      <div class="fee-tier">
                        <span class="tier-rate">{tier.rate}</span>
                        <span class="tier-desc">{tier.condition}</span>
                      </div>
                    ))}
                  </div>
                )}

                <div class="pricing-footer">
                  <p class="commitment">Min. komitmen: {data.performance.minimumCommitment}</p>
                  <p class="review-point">Review: {data.performance.reviewPoint}</p>
                </div>

                <a href="#contact" class="btn btn-primary btn-block">Pilih Paket Ini →</a>
              </div>
            )}

            {/* Fixed Price */}
            {data.pricingModel !== 'performance' && data.fixed && (
              <div class={`pricing-card ${data.recommendedModel === 'fixed' ? 'recommended' : ''}`}>
                {data.recommendedModel === 'fixed' && (
                  <div class="recommended-badge">⭐ Direkomendasikan</div>
                )}
                <div class="pricing-card-header">
                  <h3>Fixed Price</h3>
                  <p class="pricing-subtitle">Biaya tetap, tanpa kejutan</p>
                </div>
                <div class="pricing-amount">
                  <span class="amount">{data.fixed.totalPrice}</span>
                  <span class="period">untuk {data.fixed.duration}</span>
                </div>
                <div class="pricing-highlight">
                  <span class="highlight-label">Pembayaran</span>
                  <span class="highlight-value">{data.fixed.billing}</span>
                </div>

                {data.fixed.includes.length > 0 && (
                  <div class="fixed-includes">
                    <h4>Yang Anda Dapatkan</h4>
                    {data.fixed.includes.map((inc: any) => (
                      <div class="include-phase">
                        <span class="phase-label">{inc.phase}</span>
                        <ul>
                          {inc.items.map((item: string) => (
                            <li>✓ {item}</li>
                          ))}
                        </ul>
                      </div>
                    ))}
                  </div>
                )}

                <div class="pricing-footer">
                  <p class="commitment">Zero performance fee — bayar HANYA harga tetap</p>
                </div>

                <a href="#contact" class="btn btn-green btn-block">Pilih Paket Ini →</a>
              </div>
            )}
          </div>
        </section>

        <!-- ========== DELIVERY PHASES ========== -->
        <section id="phases" class="section">
          <div class="section-header">
            <span class="section-icon">⚙️</span>
            <div>
              <h2>Pengerjaan</h2>
              <p class="section-subtitle">Timeline dan apa yang akan dikerjakan</p>
            </div>
          </div>

          <div class="timeline">
            {data.phases.map((phase: any, idx: number) => (
              <div class="timeline-item">
                <div class="timeline-marker">
                  <span class="marker-number">{idx + 1}</span>
                </div>
                <div class="timeline-content">
                  <div class="timeline-header">
                    <h3>{phase.name}</h3>
                    <span class="timeline-duration">{phase.duration}</span>
                  </div>
                  <ul class="checklist">
                    {phase.items.map((item: string) => (
                      <li>
                        <span class="check-icon">✓</span>
                        <span>{item}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              </div>
            ))}
          </div>
        </section>

        {/* ========== METRICS ========== */}
        {data.metrics.length > 0 && (
          <section id="metrics" class="section">
            <div class="section-header">
              <span class="section-icon">📊</span>
              <div>
                <h2>Target Hasil</h2>
                <p class="section-subtitle">Estimasi peningkatan yang akan dicapai</p>
              </div>
            </div>

            <div class="metrics-grid">
              {data.metrics.map((metric: any) => (
                <div class="metric-card">
                  <h4 class="metric-name">{metric.metric}</h4>
                  <div class="metric-values">
                    <div class="metric-col">
                      <span class="metric-period">Bulan 1</span>
                      <span class="metric-val">{metric.month1}</span>
                    </div>
                    <div class="metric-col">
                      <span class="metric-period">Bulan 2</span>
                      <span class="metric-val">{metric.month2}</span>
                    </div>
                    <div class="metric-col">
                      <span class="metric-period">Bulan 3</span>
                      <span class="metric-val">{metric.month3}</span>
                    </div>
                    <div class="metric-col highlight">
                      <span class="metric-period">Bulan 6</span>
                      <span class="metric-val">{metric.month6}</span>
                    </div>
                  </div>
                </div>
              ))}
            </div>
          </section>
        )}

        {/* ========== ADDONS ========== */}
        {data.addons.length > 0 && (
          <section id="addons" class="section">
            <div class="section-header">
              <span class="section-icon">✨</span>
              <div>
                <h2>Layanan Tambahan</h2>
                <p class="section-subtitle">Opsional — sesuaikan dengan kebutuhan Anda</p>
              </div>
            </div>

            <div class="addons-grid">
              {data.addons.map((addon: any) => (
                <div class="addon-card">
                  <h4>{addon.name}</h4>
                  <p>{addon.description}</p>
                  <span class="addon-price">{addon.price}</span>
                </div>
              ))}
            </div>
          </section>
        )}

        {/* ========== RECOMMENDATION ========== */}
        <section id="recommendation" class="section">
          <div class="recommendation-card">
            <div class="rec-badge">🎯 Rekomendasi Kami</div>
            <h2>Kami menyarankan: <strong>{data.recommendedModel === 'performance' ? 'Performance-Based' : 'Fixed Price'}</strong></h2>
            <ul class="rec-list">
              {data.recommendationReasons.map((reason: string) => (
                <li>
                  <span class="rec-check">✅</span>
                  <span>{reason}</span>
                </li>
              ))}
            </ul>
          </div>
        </section>

        {/* ========== NEXT STEPS ========== */}
        <section id="next-steps" class="section">
          <div class="section-header">
            <span class="section-icon">📅</span>
            <div>
              <h2>Langkah Selanjutnya</h2>
              <p class="section-subtitle">Yang akan kami lakukan bersama</p>
            </div>
          </div>

          <div class="steps-timeline">
            {data.nextSteps.map((step: string, idx: number) => (
              <div class="step-item">
                <div class="step-number">{idx + 1}</div>
                <div class="step-text">{step}</div>
              </div>
            ))}
          </div>
        </section>

        {/* ========== CONTACT ========== */}
        <section id="contact" class="section">
          <div class="contact-card">
            <h3>Siap Memulai?</h3>
            <p>Hubungi kami untuk diskusi lebih lanjut</p>
            <div class="contact-info">
              <div class="contact-detail">
                <span class="contact-name">{data.contact.name}</span>
                <span class="contact-role">{data.contact.role}</span>
              </div>
              <div class="contact-links">
                <a href={`mailto:${data.contact.email}`} class="contact-link">📧 {data.contact.email}</a>
                <a href={`tel:${data.contact.phone}`} class="contact-link">📱 {data.contact.phone}</a>
                <a href={data.contact.website} target="_blank" rel="noopener" class="contact-link">🌐 {data.contact.website}</a>
              </div>
            </div>
            <a href={`mailto:${data.contact.email}?subject=Proposal: ${data.title}`} class="btn btn-primary btn-large btn-block">
              📧 Kirim Email Sekarang
            </a>
          </div>
        </section>

        <p class="disclaimer">Proposal ini berlaku hingga {validDate}. Terakhir diperbarui: {createdDate}</p>
      </div>
    </div>
  </article>

  <script>
    // TOC toggle (mobile)
    const tocToggle = document.getElementById('toc-toggle');
    const tocNav = document.getElementById('toc-nav');
    if (tocToggle && tocNav) {
      tocToggle.addEventListener('click', () => tocNav.classList.toggle('open'));
    }
    // Share button
    const shareBtn = document.getElementById('share-btn');
    if (shareBtn) {
      shareBtn.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(window.location.href);
          shareBtn.textContent = '✓ URL disalin!';
          setTimeout(() => { shareBtn.textContent = '🔗 Share'; }, 2000);
        } catch {
          prompt('Salin URL ini:', window.location.href);
        }
      });
    }
    // Active TOC highlight
    const sections = document.querySelectorAll('.section[id]');
    const tocLinks = document.querySelectorAll('.toc-link');
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          tocLinks.forEach(l => l.classList.remove('active'));
          const id = entry.target.id;
          const active = document.querySelector(`.toc-link[href="#${id}"]`);
          if (active) active.classList.add('active');
        }
      });
    }, { rootMargin: '-20% 0px -70% 0px' });
    sections.forEach(s => observer.observe(s));
  </script>

  <style>
    /* ========== HERO ========== */
    .hero {
      background: linear-gradient(135deg, #1e40af 0%, #7c3aed 50%, #4f46e5 100%);
      color: white;
      padding: 4rem 0 3rem;
      position: relative;
      overflow: hidden;
    }
    .hero::before {
      content: '';
      position: absolute;
      top: -50%;
      right: -20%;
      width: 600px;
      height: 600px;
      background: radial-gradient(circle, rgba(255,255,255,0.08) 0%, transparent 70%);
      border-radius: 50%;
    }
    .hero-content { position: relative; z-index: 1; max-width: 700px; }
    .hero-badges { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1.5rem; }
    .badge {
      display: inline-flex;
      align-items: center;
      padding: 0.35rem 0.75rem;
      border-radius: 20px;
      font-size: 0.8rem;
      font-weight: 600;
      background: rgba(255,255,255,0.15);
      backdrop-filter: blur(4px);
    }
    .hero h1 {
      font-size: 2.5rem;
      font-weight: 800;
      line-height: 1.15;
      margin: 0 0 0.75rem;
      letter-spacing: -0.02em;
    }
    .hero-tagline {
      font-size: 1.2rem;
      font-weight: 600;
      opacity: 0.95;
      margin: 0 0 0.5rem;
    }
    .hero-desc {
      font-size: 1rem;
      opacity: 0.85;
      line-height: 1.6;
      margin: 0 0 1.5rem;
    }
    .hero-actions { display: flex; gap: 0.75rem; flex-wrap: wrap; }

    /* ========== BUTTONS ========== */
    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 0.7rem 1.5rem;
      border-radius: var(--radius);
      font-weight: 600;
      font-size: 0.95rem;
      text-decoration: none;
      border: none;
      cursor: pointer;
      transition: all 0.2s;
      gap: 0.5rem;
      font-family: var(--font);
    }
    .btn:hover { transform: translateY(-1px); }
    .btn-primary { background: var(--accent); color: white; }
    .btn-primary:hover { background: var(--accent-hover); }
    .btn-green { background: var(--green); color: white; }
    .btn-green:hover { opacity: 0.9; }
    .btn-white { background: white; color: #1e40af; }
    .btn-white:hover { background: #f0f0f0; }
    .btn-outline-white { background: transparent; color: white; border: 2px solid rgba(255,255,255,0.3); }
    .btn-outline-white:hover { border-color: white; background: rgba(255,255,255,0.1); }
    .btn-block { width: 100%; }
    .btn-large { padding: 1rem 2rem; font-size: 1.05rem; }

    /* ========== LAYOUT ========== */
    .proposal-layout {
      display: grid;
      grid-template-columns: 220px 1fr;
      gap: 2.5rem;
      padding-top: 2rem;
      align-items: start;
    }

    /* ========== TOC ========== */
    .toc {
      position: sticky;
      top: 80px;
      padding: 1rem 0;
    }
    .toc-header {
      display: none;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 0.75rem;
    }
    .toc-title { font-weight: 700; font-size: 0.95rem; }
    .toc-toggle {
      background: var(--bg-tertiary);
      border: 1px solid var(--border);
      border-radius: var(--radius-sm);
      padding: 0.4rem 0.6rem;
      cursor: pointer;
      font-size: 1rem;
      color: var(--text-primary);
    }
    .toc-nav {
      display: flex;
      flex-direction: column;
      gap: 0.25rem;
    }
    .toc-link {
      display: block;
      padding: 0.5rem 0.75rem;
      color: var(--text-secondary);
      text-decoration: none;
      font-size: 0.85rem;
      font-weight: 500;
      border-radius: var(--radius-sm);
      border-left: 2px solid transparent;
      transition: all 0.15s;
    }
    .toc-link:hover { color: var(--accent); background: var(--accent-light); }
    .toc-link.active {
      color: var(--accent);
      background: var(--accent-light);
      border-left-color: var(--accent);
      font-weight: 600;
    }

    /* ========== SECTIONS ========== */
    .section {
      margin-bottom: 3rem;
      scroll-margin-top: 80px;
    }
    .section-header {
      display: flex;
      align-items: flex-start;
      gap: 1rem;
      margin-bottom: 1.5rem;
    }
    .section-icon {
      font-size: 1.5rem;
      flex-shrink: 0;
      margin-top: 0.1rem;
    }
    .section-header h2 {
      margin: 0;
      font-size: 1.5rem;
      font-weight: 800;
      letter-spacing: -0.01em;
    }
    .section-subtitle {
      margin: 0.25rem 0 0;
      color: var(--text-secondary);
      font-size: 0.95rem;
    }

    /* ========== PRICING ========== */
    .pricing-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
      gap: 1.5rem;
    }
    .pricing-card {
      background: var(--bg-secondary);
      border: 2px solid var(--border);
      border-radius: var(--radius-lg);
      padding: 1.75rem;
      position: relative;
      transition: border-color 0.2s, box-shadow 0.2s;
    }
    .pricing-card:hover { border-color: var(--border-strong); box-shadow: var(--shadow-md); }
    .pricing-card.recommended { border-color: var(--accent); box-shadow: 0 0 0 1px var(--accent); }
    .recommended-badge {
      position: absolute;
      top: -12px;
      left: 1.5rem;
      background: var(--accent);
      color: white;
      padding: 0.25rem 0.75rem;
      border-radius: 20px;
      font-size: 0.8rem;
      font-weight: 700;
    }
    .pricing-card-header { margin-bottom: 1.25rem; }
    .pricing-card-header h3 { margin: 0; font-size: 1.25rem; font-weight: 700; }
    .pricing-subtitle { margin: 0.25rem 0 0; color: var(--text-secondary); font-size: 0.9rem; }
    .pricing-amount {
      display: flex;
      align-items: baseline;
      gap: 0.5rem;
      margin-bottom: 0.5rem;
    }
    .amount { font-size: 1.75rem; font-weight: 800; color: var(--accent); letter-spacing: -0.02em; }
    .period { color: var(--text-secondary); font-size: 0.9rem; }
    .pricing-highlight {
      background: var(--accent-light);
      border-radius: var(--radius);
      padding: 0.75rem 1rem;
      margin: 1rem 0;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .highlight-label { font-weight: 600; font-size: 0.9rem; }
    .highlight-value { font-weight: 700; color: var(--accent); }
    .fee-tiers { margin: 1rem 0; }
    .fee-tiers h4 { margin: 0 0 0.5rem; font-size: 0.9rem; color: var(--text-secondary); }
    .fee-tier {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 0.5rem 0;
      border-bottom: 1px solid var(--border);
      font-size: 0.9rem;
    }
    .fee-tier:last-child { border-bottom: none; }
    .tier-rate { font-weight: 700; color: var(--accent); }
    .tier-desc { color: var(--text-secondary); }
    .fixed-includes { margin: 1rem 0; }
    .fixed-includes h4 { margin: 0 0 0.75rem; font-size: 0.9rem; color: var(--text-secondary); }
    .include-phase { margin-bottom: 0.75rem; }
    .phase-label {
      display: block;
      font-weight: 700;
      font-size: 0.9rem;
      margin-bottom: 0.35rem;
      color: var(--text-primary);
    }
    .include-phase ul { list-style: none; padding: 0; margin: 0; }
    .include-phase li {
      padding: 0.25rem 0;
      font-size: 0.85rem;
      color: var(--text-secondary);
      display: flex;
      gap: 0.4rem;
    }
    .pricing-footer { margin: 1rem 0 1.25rem; }
    .commitment, .review-point {
      font-size: 0.85rem;
      color: var(--text-secondary);
      margin: 0.25rem 0;
    }

    /* ========== TIMELINE ========== */
    .timeline {
      position: relative;
      padding-left: 2rem;
    }
    .timeline::before {
      content: '';
      position: absolute;
      left: 15px;
      top: 0;
      bottom: 0;
      width: 2px;
      background: var(--border);
    }
    .timeline-item {
      position: relative;
      margin-bottom: 2rem;
    }
    .timeline-marker {
      position: absolute;
      left: -2rem;
      top: 0;
      width: 32px;
      height: 32px;
      background: var(--accent);
      color: white;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: 700;
      font-size: 0.85rem;
      z-index: 1;
    }
    .timeline-content {
      background: var(--bg-secondary);
      border: 1px solid var(--border);
      border-radius: var(--radius-lg);
      padding: 1.25rem;
    }
    .timeline-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 0.75rem;
      flex-wrap: wrap;
      gap: 0.5rem;
    }
    .timeline-header h3 { margin: 0; font-size: 1.05rem; font-weight: 700; }
    .timeline-duration {
      font-size: 0.8rem;
      font-weight: 600;
      color: var(--accent);
      background: var(--accent-light);
      padding: 0.2rem 0.6rem;
      border-radius: 12px;
    }
    .checklist { list-style: none; padding: 0; margin: 0; }
    .checklist li {
      display: flex;
      align-items: flex-start;
      gap: 0.5rem;
      padding: 0.4rem 0;
      font-size: 0.9rem;
      color: var(--text-secondary);
    }
    .check-icon { color: var(--green); font-weight: 700; flex-shrink: 0; }

    /* ========== METRICS ========== */
    .metrics-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 1rem;
    }
    .metric-card {
      background: var(--bg-secondary);
      border: 1px solid var(--border);
      border-radius: var(--radius-lg);
      padding: 1.25rem;
      text-align: center;
    }
    .metric-name {
      margin: 0 0 1rem;
      font-size: 0.95rem;
      font-weight: 700;
      color: var(--text-primary);
    }
    .metric-values { display: flex; justify-content: space-between; gap: 0.25rem; }

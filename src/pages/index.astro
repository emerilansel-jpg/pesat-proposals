---
import { getCollection } from 'astro:content';

const proposals = await getCollection('proposals');
const published = proposals.filter(p => !p.data.draft);
published.sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());
---

<!doctype html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Proposal | Pesat AI</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
  <link rel="icon" type="image/svg+xml" href="/logo.svg" />
</head>
<body>
  <div class="doc">
    <header class="doc-header">
      <div class="doc-brand">
        <svg width="32" height="32" viewBox="0 0 40 40" fill="none"><rect width="40" height="40" rx="10" fill="#00d4aa"/><text x="50%" y="55%" dominant-baseline="middle" text-anchor="middle" fill="#0a0a2e" font-family="Inter,sans-serif" font-weight="900" font-size="18">P</text></svg>
        <span class="brand-name">Pesat AI</span>
      </div>
      <h1>Proposal</h1>
    </header>
    <section class="list">
      {published.length === 0 ? (
        <p class="empty">Belum ada proposal.</p>
      ) : (
        <ul>
          {published.map(p => {
            const slug = p.data.slug || p.slug;
            return <li><a href={`/${slug}/`}><strong>{p.data.client}</strong><span>{p.data.title}</span></a></li>;
          })}
        </ul>
      )}
    </section>
    <footer class="doc-footer"><p>Pesat AI &copy; 2026</p></footer>
  </div>

  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: 'Inter', system-ui, sans-serif; background: #f5f5f5; color: #111; line-height: 1.7; -webkit-font-smoothing: antialiased; }
    .doc { max-width: 720px; margin: 0 auto; background: #fff; min-height: 100vh; box-shadow: 0 0 0 1px rgba(0,0,0,0.05), 0 4px 24px rgba(0,0,0,0.06); }
    .doc-header { text-align: center; padding: 2rem 1.5rem 1.5rem; border-bottom: 2px solid #111; }
    .doc-brand { display: flex; align-items: center; justify-content: center; gap: 0.5rem; margin-bottom: 1rem; }
    .brand-name { font-size: 0.9rem; font-weight: 800; color: #111; letter-spacing: 0.03em; }
    .doc-header h1 { font-size: 1.4rem; font-weight: 800; }
    .list { padding: 1rem 1.25rem 2rem; }
    .list ul { list-style: none; }
    .list li { border-bottom: 1px solid #eee; }
    .list li:last-child { border-bottom: none; }
    .list a { display: flex; justify-content: space-between; align-items: center; padding: 0.85rem 0; text-decoration: none; color: #111; gap: 1rem; }
    .list a:hover { color: #00d4aa; }
    .list strong { font-size: 0.95rem; color: #00d4aa; }
    .list span { font-size: 0.82rem; color: #999; text-align: right; }
    .empty { text-align: center; color: #999; padding: 2rem 0; }
    .doc-footer { border-top: 1px solid #eee; padding: 1.25rem; text-align: center; font-size: 0.78rem; color: #999; }
    @media (max-width: 640px) { body { background: #fff; } .doc { box-shadow: none; } .doc-header { padding: 1.25rem 1rem 1rem; } .list { padding: 1rem 0.75rem 1.5rem; } .list a { flex-direction: column; align-items: flex-start; gap: 0.25rem; } }
  </style>
</body>
</html>

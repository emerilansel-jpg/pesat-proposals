---
import Main from '@/layouts/Main.astro';
import { getCollection } from 'astro:content';

const proposals = await getCollection('proposals');
const published = proposals.filter(p => !p.data.draft);
published.sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());
---

<Main title="Pesat AI — Proposal">
  <div class="doc">
    <header class="doc-header">
      <div class="doc-brand">
        <img src="/logo.svg" alt="Pesat AI" width="32" height="32" />
        <span>PESAT AI</span>
      </div>
      <h1>Proposal</h1>
      <p>Geographic Entity Optimization & AI Search Strategy</p>
    </header>
    <section class="list">
      {published.length === 0 ? (
        <p class="empty">Belum ada proposal yang dipublikasikan.</p>
      ) : (
        <ul>
          {published.map(p => (
            <li>
              <a href={`/p/${p.slug}/`}>
                <strong>{p.data.client}</strong>
                <span>{p.data.title}</span>
              </a>
            </li>
          ))}
        </ul>
      )}
    </section>
    <footer class="doc-footer">
      <p>Pesat AI &copy; {new Date().getFullYear()}</p>
    </footer>
  </div>

  <style>
    .doc { box-shadow: 0 0 40px rgba(0,0,0,0.08); }
    .doc-header {
      border-bottom: 3px solid #1e40af;
      padding: 2.5rem;
    }
    .doc-brand {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      font-weight: 800;
      font-size: 0.85rem;
      letter-spacing: 0.05em;
      color: #1e40af;
      margin-bottom: 1.5rem;
    }
    .doc-brand img { width: 28px; height: 28px; }
    .doc-header h1 { font-size: 1.75rem; font-weight: 800; margin: 0 0 0.25rem; color: #0f172a; }
    .doc-header p { color: #64748b; font-size: 0.95rem; margin: 0; }
    .list { padding: 1.5rem 2.5rem; }
    .list ul { list-style: none; padding: 0; margin: 0; }
    .list li { border-bottom: 1px solid #e2e8f0; }
    .list li:last-child { border-bottom: none; }
    .list a {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 1rem 0;
      text-decoration: none;
      color: #1a1a2e;
      gap: 1rem;
    }
    .list a:hover { color: #1e40af; }
    .list strong { font-size: 0.95rem; }
    .list span { font-size: 0.85rem; color: #64748b; text-align: right; }
    .empty { padding: 2rem 0; text-align: center; color: #94a3b8; }
    .doc-footer {
      padding: 1.5rem 2.5rem;
      border-top: 3px solid #1e40af;
      text-align: center;
      font-size: 0.8rem;
      color: #94a3b8;
    }
    @media (max-width: 600px) {
      .doc-header, .list, .doc-footer { padding-left: 1.25rem; padding-right: 1.25rem; }
      .list a { flex-direction: column; align-items: flex-start; gap: 0.25rem; }
      .list span { text-align: left; }
    }
  </style>
</Main>

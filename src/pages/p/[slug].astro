---
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const proposals = await getCollection('proposals');
  const published = proposals.filter(p => !p.data.draft);
  return published.map(p => ({
    params: { slug: p.slug },
    props: { proposal: p },
  }));
}

const { proposal } = Astro.props;
const data = proposal.data;
const { Content } = await proposal.render();
---

<!doctype html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{data.title} | Pesat AI</title>
  <meta name="robots" content="noindex,nofollow" />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
  <link rel="icon" type="image/svg+xml" href="/logo.svg" />
</head>
<body>
  <div class="doc">
    <!-- Header -->
    <header class="doc-header">
      <div class="doc-brand">
        <svg width="36" height="36" viewBox="0 0 40 40" fill="none"><rect width="40" height="40" rx="8" fill="#00d4aa"/><text x="50%" y="54%" dominant-baseline="middle" text-anchor="middle" fill="#0a0a2e" font-family="Inter,sans-serif" font-weight="900" font-size="18">P</text></svg>
        <div>
          <span class="brand-name">Pesat AI</span>
          <span class="brand-sub">Geographic Entity Optimization</span>
        </div>
      </div>
      <h1>{data.title}</h1>
      <p class="doc-for">Untuk: <strong>{data.client}</strong></p>
      <p class="doc-meta">
        {new Date(data.date).toLocaleDateString('id-ID', { year: 'numeric', month: 'long', day: 'numeric' })}
        &nbsp;·&nbsp;
        Berlaku hingga {new Date(data.validUntil).toLocaleDateString('id-ID', { year: 'numeric', month: 'long', day: 'numeric' })}
      </p>
    </header>

    <div class="doc-body">
      <Content />
    </div>

    <footer class="doc-footer">
      <p>Pesat AI &copy; 2026 &mdash; Dokumen konfidensial</p>
    </footer>
  </div>
</body>
</html>

<style>
  :root {
    --navy: #0a0a2e;
    --navy-light: #12123a;
    --navy-card: #1a1a4a;
    --teal: #00d4aa;
    --teal-bright: #00ffcc;
    --white: #ffffff;
    --gray-300: #cbd5e1;
    --gray-400: #94a3b8;
    --gray-600: #475569;
    --gold: #f59e0b;
    --red: #ef4444;
  }

  * { box-sizing: border-box; margin: 0; padding: 0; }

  body {
    font-family: 'Inter', system-ui, -apple-system, sans-serif;
    background: var(--navy);
    color: var(--white);
    line-height: 1.7;
    -webkit-font-smoothing: antialiased;
  }

  .doc {
    max-width: 780px;
    margin: 0 auto;
    background: var(--navy);
    min-height: 100vh;
  }

  /* Header */
  .doc-header {
    text-align: center;
    padding: 2rem 1.5rem 1.5rem;
    border-bottom: 1px solid rgba(0,212,170,0.15);
  }
  .doc-brand {
    display: flex; align-items: center; justify-content: center; gap: 0.6rem;
    margin-bottom: 1.25rem;
  }
  .brand-name { display: block; font-size: 1.1rem; font-weight: 800; color: var(--white); letter-spacing: 0.02em; }
  .brand-sub  { display: block; font-size: 0.68rem; color: var(--teal); text-transform: uppercase; letter-spacing: 0.05em; }
  .doc-header h1 {
    font-size: 1.5rem; font-weight: 800; color: var(--white); line-height: 1.3; margin-bottom: 0.4rem;
  }
  .doc-for { color: var(--gray-300); font-size: 0.95rem; margin-bottom: 0.5rem; }
  .doc-for strong { color: var(--teal); }
  .doc-meta { font-size: 0.78rem; color: var(--gray-400); }

  /* Body */
  .doc-body { padding: 1.5rem 1.25rem 2rem; }

  .doc-body h2 {
    font-size: 1.2rem; font-weight: 800; color: var(--white);
    border-left: 3px solid var(--teal); padding-left: 0.7rem;
    margin: 2.5rem 0 0.75rem;
  }
  .doc-body h2:first-child { margin-top: 0; }
  .doc-body h3 { font-size: 1rem; font-weight: 700; color: var(--teal); margin: 1.5rem 0 0.5rem; }
  .doc-body h4 { font-size: 0.9rem; font-weight: 700; color: var(--white); margin: 1rem 0 0.35rem; }
  .doc-body p { color: var(--gray-300); margin-bottom: 0.7rem; }
  .doc-body ul, .doc-body ol { color: var(--gray-300); padding-left: 1.25rem; margin-bottom: 0.7rem; }
  .doc-body li { margin-bottom: 0.35rem; }
  .doc-body strong { color: var(--white); }
  .doc-body hr { border: none; border-top: 1px solid rgba(255,255,255,0.06); margin: 1.5rem 0; }

  /* Tables — responsive: key-value rows */
  .doc-body table {
    width: 100%; border-collapse: collapse; margin: 0.75rem 0 1.25rem; font-size: 0.83rem;
  }
  .doc-body th, .doc-body td { padding: 0.45rem 0.6rem; text-align: left; vertical-align: top; }
  .doc-body th { font-weight: 700; color: var(--teal); border-bottom: 1px solid rgba(255,255,255,0.08); }
  .doc-body td { color: var(--gray-300); border-bottom: 1px solid rgba(255,255,255,0.04); }
  .doc-body tr:last-child td { border-bottom: none; }
  .doc-body td:first-child { color: var(--white); font-weight: 600; }

  /* Blockquote */
  .doc-body blockquote {
    background: var(--navy-card); border-left: 3px solid var(--teal);
    margin: 0.75rem 0; padding: 0.65rem 0.9rem; border-radius: 0 6px 6px 0;
    font-size: 0.82rem; color: var(--gray-300);
  }
  .doc-body blockquote p { margin-bottom: 0.25rem; }
  .doc-body blockquote strong { color: var(--teal); }

  /* Footer */
  .doc-footer {
    border-top: 1px solid rgba(0,212,170,0.15); padding: 1.25rem; text-align: center;
    font-size: 0.78rem; color: var(--gray-600);
  }

  /* Print */
  @media print {
    body { background: #fff; color: #111; }
    .doc { max-width: 100%; }
    .doc-body { padding: 0; }
    .doc-body :is(h2,h3,h4,p,li,td,th) { color: #111 !important; }
    .doc-body h3 { color: #0a0a2e !important; }
    .doc-header, .doc-footer { background: #f8f8f8; }
  }

  /* Mobile */
  @media (max-width: 600px) {
    .doc-header { padding: 1.25rem 1rem 1rem; }
    .doc-header h1 { font-size: 1.2rem; }
    .doc-body { padding: 1rem 0.75rem 1.5rem; }
    .doc-body h2 { font-size: 1.05rem; }
    .doc-body h3 { font-size: 0.92rem; }
    .doc-body table { font-size: 0.78rem; }
    .doc-body th, .doc-body td { padding: 0.35rem 0.4rem; }
  }
</style>

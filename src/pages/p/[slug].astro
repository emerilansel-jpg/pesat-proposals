---
import { getCollection } from 'astro:content';
import Main from '@/layouts/Main.astro';

export async function getStaticPaths() {
  const proposals = await getCollection('proposals');
  return proposals.map((proposal) => ({
    params: { slug: proposal.slug },
    props: { proposal },
  }));
}

const { proposal } = Astro.props;
const d = proposal.data;
const { Content } = await proposal.render();
const validDate = new Date(d.validUntil).toLocaleDateString('id-ID', { year: 'numeric', month: 'long', day: 'numeric' });
const createdDate = new Date(d.date).toLocaleDateString('id-ID', { year: 'numeric', month: 'long', day: 'numeric' });
---

<Main title={`${d.title} | Pesat AI`}>
  <div class="doc">

    <!-- Header -->
    <header class="doc-header">
      <div class="doc-header-inner">
        <div class="doc-brand">
          <img src="/logo.svg" alt="Pesat AI" width="32" height="32" />
          <span>PESAT AI</span>
        </div>
        <div class="doc-title">
          <h1>{d.title}</h1>
          <p class="doc-client">{d.client}</p>
        </div>
        <div class="doc-meta">
          <span>Direvisi: {createdDate}</span>
          <span>Berlaku hingga: {validDate}</span>
        </div>
      </div>
    </header>

    <!-- Rendered Markdown Body -->
    <div class="doc-body">
      <Content />
    </div>

    <!-- Footer -->
    <footer class="doc-footer">
      <p>Pesat AI &copy; {new Date().getFullYear()} &mdash; Geographic Entity Optimization</p>
      <p>Proposal ini berlaku hingga {validDate}</p>
    </footer>
  </div>

  <style>
    /* Document */
    .doc {
      box-shadow: 0 0 40px rgba(0,0,0,0.08);
    }

    /* Header */
    .doc-header {
      border-bottom: 3px solid #1e40af;
      padding: 2.5rem 2.5rem 2rem;
    }
    .doc-header-inner { max-width: 100%; }
    .doc-brand {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      font-weight: 800;
      font-size: 0.85rem;
      letter-spacing: 0.05em;
      color: #1e40af;
      margin-bottom: 1.5rem;
    }
    .doc-brand img { width: 28px; height: 28px; }
    .doc-title h1 {
      font-size: 1.75rem;
      font-weight: 800;
      line-height: 1.2;
      margin: 0 0 0.25rem;
      color: #0f172a;
      letter-spacing: -0.02em;
    }
    .doc-client {
      font-size: 1.1rem;
      color: #1e40af;
      font-weight: 600;
      margin: 0 0 1rem;
    }
    .doc-meta {
      display: flex;
      gap: 1.5rem;
      font-size: 0.85rem;
      color: #64748b;
    }

    /* Markdown Body */
    .doc-body {
      padding: 0 2.5rem 2rem;
    }
    .doc-body :global(h2) {
      font-size: 1.15rem;
      font-weight: 700;
      margin: 2rem 0 0.75rem;
      color: #0f172a;
      padding-bottom: 0.5rem;
      border-bottom: 2px solid #e2e8f0;
    }
    .doc-body :global(h3) {
      font-size: 0.95rem;
      font-weight: 700;
      margin: 1.25rem 0 0.5rem;
      color: #1e293b;
    }
    .doc-body :global(p) {
      font-size: 0.92rem;
      color: #334155;
      margin: 0.5rem 0;
      line-height: 1.7;
    }
    .doc-body :global(ul), .doc-body :global(ol) {
      padding-left: 1.25rem;
      margin: 0.5rem 0;
    }
    .doc-body :global(li) {
      font-size: 0.9rem;
      color: #475569;
      margin-bottom: 0.35rem;
      line-height: 1.6;
    }
    .doc-body :global(table) {
      width: 100%;
      border-collapse: collapse;
      margin: 0.75rem 0;
      font-size: 0.88rem;
    }
    .doc-body :global(th), .doc-body :global(td) {
      padding: 0.55rem 0.75rem;
      text-align: left;
      border-bottom: 1px solid #e2e8f0;
    }
    .doc-body :global(th) {
      font-weight: 600;
      color: #64748b;
      font-size: 0.78rem;
      text-transform: uppercase;
      letter-spacing: 0.03em;
      background: #f8fafc;
    }
    .doc-body :global(td) { color: #334155; }
    .doc-body :global(blockquote) {
      border-left: 3px solid #1e40af;
      padding: 0.75rem 1rem;
      margin: 1rem 0;
      background: #f8fafc;
      font-size: 0.88rem;
      color: #475569;
    }
    .doc-body :global(blockquote p) { margin: 0.25rem 0; }
    .doc-body :global(strong) { color: #0f172a; }
    .doc-body :global(hr) {
      border: none;
      border-top: 1px solid #e2e8f0;
      margin: 1.5rem 0;
    }
    .doc-body :global(a) {
      color: #1e40af;
      text-decoration: none;
    }
    .doc-body :global(a:hover) {
      text-decoration: underline;
    }

    /* Footer */
    .doc-footer {
      padding: 1.5rem 2.5rem;
      border-top: 3px solid #1e40af;
      text-align: center;
      font-size: 0.8rem;
      color: #94a3b8;
    }
    .doc-footer p { margin: 0.15rem 0; }

    /* Print */
    @media print {
      .doc { box-shadow: none; max-width: 100%; }
      .doc-body :global(section) { break-inside: avoid; }
    }

    /* Mobile */
    @media (max-width: 600px) {
      .doc-header { padding: 1.5rem 1.25rem 1.25rem; }
      .doc-title h1 { font-size: 1.35rem; }
      .doc-meta { flex-direction: column; gap: 0.25rem; }
      .doc-body { padding: 0 1.25rem 1.5rem; }
      .doc-body :global(table) { font-size: 0.8rem; }
      .doc-body :global(th), .doc-body :global(td) { padding: 0.4rem 0.5rem; }
      .doc-footer { padding: 1rem 1.25rem; }
    }
  </style>
</Main>
